# Copy to .env.production. Never commit the populated file.
FIREWATCH_DOMAIN=firewatch.example.com
# Generate locally: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
API_ACCESS_TOKEN=
CAMERA_AUTO_SCAN_INTERVAL_SEC=30
CAMERA_CONFIRMATION_FRAMES=3
CAMERA_ALERT_MIN_CONFIDENCE=0.5
# Optional: place your Firebase Admin JSON in secrets/firebase-service-account.json
# and set FIREBASE_CREDENTIALS=/run/secrets/firebase-service-account.json
FIREBASE_CREDENTIALS=
