# Скопируйте в backend/.env для локальной демонстрации (Mac + iPhone по локальному Wi-Fi).
# НЕ коммитьте реальные секреты.

# Режим окружения: local_dev | production
ENV_MODE=local_dev
HOST=0.0.0.0
PORT=8000

# Необязательная защита API. Задайте длинный случайный токен и тот же токен в настройках iOS.
# Если пусто, API не требует ключ (используйте только в доверенной локальной сети).
API_ACCESS_TOKEN=

# SQLite и медиа (относительно backend/)
DATABASE_PATH=data/firewatch.db
MEDIA_DIR=data/media
CAMERAS_FILE=cameras.json

# Детектор: auto (YOLO, если есть веса и ultralytics, иначе DEMO-эвристика) | yolo | heuristic
DETECTOR=auto
YOLO_WEIGHTS=models/fire_smoke_yolov8n.pt
DETECTION_CONF=0.25
MAX_UPLOAD_MB=30

# Firebase Admin service account JSON (необязательно). Пусто = локальные in-app уведомления.
FIREBASE_CREDENTIALS=

# Запись клипа при симуляции
CLIP_SECONDS=5
DEFAULT_CAMERA_ID=cam4

# CORS: "*" для локальной разработки и демо по Wi-Fi
CORS_ORIGINS=*
